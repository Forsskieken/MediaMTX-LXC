# DoorBird D1101V camer
CAM=ingang
# input
SRC_RTSP="rtsp://user:password@ip-addres/mpeg/media.amp"

# publish destination in MediaMTX
DST_VIDEO="ingang-video"

# For DoorBird: re-encode to fix timestamp weirdness
VIDEO_MODE="encode"
VIDEO_FPS="10"
VIDEO_GOP="20"

# rtsp client settings
RTSP_TRANSPORT="tcp"
RTSP_TIMEOUT_US="60000000"     # 60s (microseconds)

# make ffmpeg probe enough to estimate FPS etc
ANALYZE_US="1000000"
PROBESIZE="1000000"

# timing helpers (important for DoorBird)
GENPTS="0"

# force re-encode video (instead of copy)
VIDEO_MODE="encode"

# encoder knobs (stable)
VIDEO_FPS="10"
VIDEO_GOP="20"
